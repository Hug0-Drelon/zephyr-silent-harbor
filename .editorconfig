# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,zsh}]
indent_style = tab

[**/.zshrc]
[**/.zprofile]
indent_style = tab

[zsh/**]
indent_style = tab

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[LICENSE]
trim_trailing_whitespace = false
